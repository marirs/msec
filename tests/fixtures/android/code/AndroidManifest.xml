<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture for msec's DEX reader: an app with compiled code in two DEX files. Rebuild with
     ../build_dex.sh after editing. classes.dex comes from java/primary, classes2.dex from
     java/secondary, which redefines Config so the copy in classes2.dex is shadowed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.appchk.fixture.code"
    android:versionCode="7"
    android:versionName="2.0">
  <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>
  <application android:label="@string/app_name">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
