<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture for msec's Google Play store-readiness checks. Rebuild with ../build.sh after
     editing. Target API 34 (below Play's 2026 requirement), a versionCode above Play's
     maximum, Play-restricted permissions, an accessibility service, and a foreground service
     whose microphone type lacks its permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.appchk.fixture.store"
    android:versionCode="2100000001"
    android:versionName="1.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
  <uses-permission android:name="android.permission.READ_SMS"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
  <uses-permission android:name="android.permission.health.READ_STEPS"/>
  <application android:label="@string/app_name">
    <service android:name=".CaptureService" android:exported="false"
        android:foregroundServiceType="camera|microphone"/>
    <service android:name=".SyncService" android:exported="false"/>
    <service android:name=".HelperService" android:exported="true"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"/>
  </application>
</manifest>
